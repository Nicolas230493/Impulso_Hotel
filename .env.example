# Copiar a .env y completar. Nunca subir .env al repositorio.
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=impulso
POSTGRES_USER=impulso
POSTGRES_PASSWORD=impulso
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Doble factor obligatorio para administradores (por defecto activo cuando DEBUG=False)
REQUIRE_2FA_ADMINS=False

# Email (por defecto se imprime en consola)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Impulso Hotel <no-responder@impulso.com.ar>

# ARCA: simulado | homologacion | produccion
ARCA_MODO=simulado
ARCA_CUIT=
ARCA_CERT=/ruta/certificado.crt
ARCA_KEY=/ruta/clave.key

# WhatsApp Business Cloud API: simulado | real
WHATSAPP_MODO=simulado
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

PASARELA_MODO=simulado
CHANNEL_MANAGER_MODO=simulado
